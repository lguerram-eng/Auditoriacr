# ============================================================================
# Muenra Vouching — variables de entorno (copie a .env y ajuste los valores)
# NUNCA versione el archivo .env: contiene secretos.
# ============================================================================

# Entorno: development | production
MUENRA_ENV=production

# Base de datos PostgreSQL (docker-compose construye la URL con estos valores)
POSTGRES_DB=muenra
POSTGRES_USER=muenra
POSTGRES_PASSWORD=cambie-esta-contrasena

# Secreto para firmar sesiones JWT (mínimo 32 caracteres aleatorios)
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
MUENRA_SECRET_KEY=

# Clave de cifrado en reposo de los documentos (Fernet, 32 bytes base64)
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ¡Respáldela! Sin esta clave los documentos almacenados no se pueden descifrar.
MUENRA_STORAGE_ENCRYPTION_KEY=

# Administrador inicial (solo se crea si la base no tiene usuarios)
MUENRA_BOOTSTRAP_ADMIN_EMAIL=admin@su-empresa.com
MUENRA_BOOTSTRAP_ADMIN_PASSWORD=

# Sesiones y bloqueo de cuentas
MUENRA_ACCESS_TOKEN_MINUTES=60
MUENRA_MAX_LOGIN_ATTEMPTS=5
MUENRA_LOCKOUT_MINUTES=15
MUENRA_CORS_ORIGINS=http://localhost:8080

# Archivos
MUENRA_MAX_FILE_MB=50
MUENRA_MAX_FILES_PER_UPLOAD=500
# Antivirus ClamAV (perfil "antivirus" de docker-compose)
MUENRA_CLAMAV_HOST=
MUENRA_CLAMAV_PORT=3310
MUENRA_ANTIVIRUS_REQUIRED=false

# OCR
MUENRA_OCR_LANGUAGES=spa+eng
MUENRA_OCR_DPI=300

# Cola de procesamiento (en Docker se usa el servicio "worker")
MUENRA_INLINE_WORKER=false
WORKER_REPLICAS=1

# Inteligencia artificial (opcional; además debe autorizarse en cada proyecto)
MUENRA_LLM_ENABLED=false
MUENRA_LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Correo para recuperación de contraseña
MUENRA_SMTP_HOST=
MUENRA_SMTP_PORT=587
MUENRA_SMTP_USER=
MUENRA_SMTP_PASSWORD=
MUENRA_SMTP_FROM=no-reply@su-empresa.com
MUENRA_PUBLIC_URL=http://localhost:8080

# Puerto HTTP publicado por Nginx
HTTP_PORT=8080
